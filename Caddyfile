{
	# No ACME, no certificate requests, no outbound traffic of any kind.
	auto_https off

	# Caddy owns port 80 so local hostnames work without a port suffix.
	# Override with the LOCALFRONT_CADDY_PORT environment variable.
	http_port {$LOCALFRONT_CADDY_PORT:80}
}

# CowFront's admin dashboard. Answered only for clients on this machine: the
# listener is shared with the LAN routes below, so the guard is what keeps the
# dashboard private rather than the socket binding.
http://cowfront.local {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront's dashboard is available only on the machine running it." 403

	reverse_proxy 127.0.0.1:5744
}

# CowFront distribution routes - managed block
# Generated by CowFront. Edit distributions in the dashboard.
http://cdn.hds.internal {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}

http://demo-orge.dev.local {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}

http://dev.uforge.build {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}

http://site.local {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}

http://system.example.com {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}

http://system.hds.internal {
	@remote not remote_ip 127.0.0.1 ::1
	respond @remote "CowFront distributions are available only on the machine running them." 403

	reverse_proxy 127.0.0.1:8080
}
# End CowFront distribution routes

# The GitHub project on 3015, reachable from other machines on the LAN. This
# replaces the Windows portproxy rule that used to forward 0.0.0.0:80 there.
#
# Two names on purpose: `.local` is reserved for mDNS (RFC 6762) and fights
# Bonjour on macOS, so teammates use `.test` (RFC 6761, never resolvable on the
# public internet). `.local` stays for this machine's own muscle memory.
http://gh-dev.test, http://gh-dev.local {
	reverse_proxy 127.0.0.1:3015
}

# Same destination by IP or any other Host header, preserving how port 80
# behaved under the portproxy rule for clients that cannot resolve gh-dev.local.
:{$LOCALFRONT_CADDY_PORT:80} {
	reverse_proxy 127.0.0.1:3015
}
