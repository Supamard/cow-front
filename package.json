{
  "name": "cow-front",
  "version": "1.2.0",
  "description": "A local, CloudFront-like CDN emulator that fronts MinIO or any HTTP origin. Zero dependencies.",
  "author": "Supamard Jittithammawat",
  "type": "module",
  "main": "localfront.mjs",
  "keywords": [
    "cowfront",
    "cow-front",
    "cdn",
    "cloudfront",
    "minio",
    "s3",
    "cache",
    "proxy",
    "cli"
  ],
  "bin": {
    "cow-front": "./localfront.mjs",
    "cowfront": "./localfront.mjs",
    "localfront": "./localfront.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node localfront.mjs serve",
    "cowfront": "node localfront.mjs",
    "cow-front": "node localfront.mjs",
    "postinstall": "node scripts/install-hosts.mjs",
    "prepublishOnly": "npm test && npm pack --dry-run",
    "serve": "node localfront.mjs serve",
    "setup": "node scripts/setup-hosts.mjs",
    "caddy:install": "node scripts/caddy.mjs install",
    "caddy:check": "node scripts/caddy.mjs check",
    "caddy:activate": "node scripts/caddy.mjs activate",
    "caddy:run": "node scripts/caddy.mjs run",
    "caddy:reload": "node scripts/caddy.mjs reload",
    "caddy:stop": "node scripts/caddy.mjs stop",
    "minio:up": "node scripts/minio-up.mjs",
    "minio:public": "node scripts/minio-public.mjs",
    "minio:down": "docker compose down",
    "hosts:setup": "node scripts/setup-hosts.mjs",
    "audit": "node localfront.mjs audit",
    "doctor": "node localfront.mjs audit",
    "share": "node scripts/share.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "distributions.example.json",
    "docker-compose.yml",
    "examples",
    "fake-origin.mjs",
    "localfront.mjs",
    "scripts",
    "style.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supamard/cow-front.git"
  },
  "homepage": "https://github.com/Supamard/cow-front#readme",
  "bugs": {
    "url": "https://github.com/Supamard/cow-front/issues"
  }
}
